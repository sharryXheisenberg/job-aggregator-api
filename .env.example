# Copy this file to .env and fill in values. .env is only for LOCAL
# development -- on Render/GitHub Actions you'll set these as real
# environment variables in each platform's settings instead.

# ---------------------------------------------------------------------------
# DATABASE_URL
# ---------------------------------------------------------------------------
# Required in production. Both main.py (on Render) and refresh.py (on
# GitHub Actions) must point at the SAME database -- otherwise the API
# serves from an empty/different database than the one refresh.py wrote to.
#
#   - LEAVE BLANK for local dev: defaults to a local SQLite file
#     (local_dev.db), created automatically. Fine for testing main.py or
#     the source parsers locally, but note refresh.py run locally against
#     SQLite won't reflect what's in your production Postgres.
#
#   - In PRODUCTION, set to your Aiven Postgres connection string:
#         postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# RAPIDAPI_PROXY_SECRET
# ---------------------------------------------------------------------------
# Optional. Same purpose as in the bank statement parser project -- leave
# blank for local dev; set to the real secret RapidAPI Studio gives you
# once you've created the listing, as an env var on Render (not in a
# committed file).
RAPIDAPI_PROXY_SECRET=

# ---------------------------------------------------------------------------
# PORT
# ---------------------------------------------------------------------------
# Optional. Which port `python main.py` binds to locally. Defaults to 8000.
PORT=8000
